# ── 依赖 ──
# node_modules 是指向 B:\NativeThink\node_modules 的 Windows junction（与 NativeThink 共用依赖）
node_modules

# ── 前端构建产物 ──
dist
tmp

# ── 本地密钥（AI 代理 Key，勿入库） ──
scripts/.apikey

# ── Android / Gradle ──
android/app/build
android/build
android/.gradle
android/.idea
android/local.properties
# 签名凭据：android/app/build.gradle 已声明「密钥库与凭据放仓库外的 android/keystore.properties」，
# 但旧 .gitignore 漏了这两条 —— 明文 storePassword/keyPassword 与 .keystore 会随首次提交入库
android/keystore.properties
android/*.keystore
android/*.jks
# cap sync 从 dist 与 capacitor.config.json 生成，可重建
android/app/src/main/assets/public
android/app/src/main/assets/capacitor.config.json

# ── 离线 TTS 模型（约 250MB，可重新获取；来源见 README「离线模型」） ──
# 注：model.int8.onnx 单个 109MB，已超 GitHub 100MB 单文件上限，本就不能直接入库
android/app/src/main/assets/tts
android/app/src/main/assets/piper
android/app/libs/sherpa-onnx-*.aar

# ── 发布产物 ──
release/*.apk
