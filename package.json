{
  "name": "cetthink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "productName": "CetThink",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build --outDir dist",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "node tests/srs.test.mjs && node tests/full-suite.mjs && node tests/full-suite-part2.mjs && node tests/verify-features.mjs",
    "data:import": "node scripts/import-cet-data.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "lucide-react": "0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9",
    "vite": "^8"
  }
}
